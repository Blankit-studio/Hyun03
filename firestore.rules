rules_version = '2';

// ============================================================
//  Firestore 보안 규칙
//  - 프로필은 누구나 읽을 수 있음(공개 페이지)
//  - 쓰기는 아래 OWNER 이메일로 로그인한 사용자만 가능
//
//  ⚠️ 아래 'shdblankit@gmail.com' 을 본인 관리자 계정 이메일로 바꾸세요.
//     (firebase-config.js 의 OWNER_EMAIL 과 반드시 동일해야 합니다.)
//
//  적용 방법:
//   Firebase 콘솔 → Firestore Database → 규칙(Rules) 탭에
//   이 내용을 붙여넣고 "게시(Publish)"
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'shdblankit@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // 프로필 문서 (site/profile)
    match /site/{document} {
      allow read: if true;        // 공개 읽기
      allow write: if isOwner();  // 관리자만 쓰기
    }

    // 그 외 모든 문서는 기본 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
