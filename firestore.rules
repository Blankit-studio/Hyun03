rules_version = '2';

// ============================================================
//  Firestore 보안 규칙 (멀티유저 프로필 플랫폼)
//
//  - 공개 프로필(public == true)은 누구나 읽기 가능
//  - 비공개 프로필은 소유자(uid)만 읽기 가능
//  - 프로필 생성/수정/삭제는 소유자 본인만 가능
//  - 아이디(username) 문서는 선점 방식: 없을 때만 생성 가능, 덮어쓰기 불가
//
//  적용: Firebase 콘솔 → Firestore Database → 규칙(Rules) → 붙여넣고 게시
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // 프로필: profiles/{uid}
    match /profiles/{uid} {
      allow read: if resource.data.public == true
                  || (request.auth != null && request.auth.uid == uid);

      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.username is string
                    && request.resource.data.uid == uid;

      allow update: if request.auth != null
                    && request.auth.uid == uid
                    // 아이디(username)는 생성 후 변경 불가
                    && request.resource.data.username == resource.data.username;

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // 아이디 예약: usernames/{username} → { uid }
    match /usernames/{name} {
      allow read: if true;                 // 가용성 확인 / 조회용 공개
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow update: if false;              // 한번 선점되면 덮어쓰기 불가
    }

    // 그 외 문서 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
